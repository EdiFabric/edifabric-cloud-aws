<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Generate ready to run images during publishing to improve cold start time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
	  <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
	  <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
	  <PackageReference Include="Amazon.Lambda.Serialization.Json" Version="3.0.0" />
	  <PackageReference Include="AWSSDK.ApiGatewayManagementApi" Version="3.7.400.87" />
	  <PackageReference Include="AWSSDK.S3" Version="3.7.413.2" />
  </ItemGroup>
	<!-- Native library: copy next to the worker on build and publish. Linux Function Apps need the .so. -->
	<ItemGroup>
		<Content Include="edifabric-x12-tools.dll" Condition="Exists('edifabric-x12-tools.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="edifabric-x12-tools.so" Condition="Exists('edifabric-x12-tools.so')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="edifabric-x12-tools.dylib" Condition="Exists('edifabric-x12-tools.dylib')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\edifabric-x12-tools.dll" Condition="Exists('..\edifabric-x12-tools.dll')" Link="edifabric-x12-tools.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\edifabric-x12-tools.so" Condition="Exists('..\edifabric-x12-tools.so')" Link="edifabric-x12-tools.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="..\edifabric-x12-tools.dylib" Condition="Exists('..\edifabric-x12-tools.dylib')" Link="edifabric-x12-tools.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="map\map.json" Condition="Exists('map\map.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
