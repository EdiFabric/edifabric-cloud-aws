{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "AWS Serverless API that exposes the parse, generate, validate, and acknowledge operations for X12 EDI using ediFabric Native.",
  "Resources": {
    "ReadX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::ReadX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to parse/read X12 files",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/read",
              "Method": "POST"
            }
          }
        }
      }
    },
    "WriteX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::WriteX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to generate/write X12 files",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/write",
              "Method": "POST"
            }
          }
        }
      }
    },
    "ValidateX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::ValidateX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to validate X12 messages",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/validate",
              "Method": "POST"
            }
          }
        }
      }
    },
    "AckX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::AckX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to generate X12 acknowledgments",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/ack",
              "Method": "POST"
            }
          }
        }
      }
    },
    "ParseX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::ParseX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to parse X12 files to JSON, with validation and acknowledgments (ediFabric Cloud v3)",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/parse",
              "Method": "POST"
            }
          }
        }
      }
    },
    "BuildX12": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "Handler": "EdiFabric.Api.AWS::X12Functions::BuildX12Async",
        "Runtime": "dotnet10",
        "CodeUri": "",
        "Description": "Function to build X12 files from JSON (ediFabric Cloud v3)",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": null,
        "Policies": [
          "AWSLambdaBasicExecutionRole"
        ],
        "Events": {
          "ProxyResource": {
            "Type": "Api",
            "Properties": {
              "Path": "/x12/build",
              "Method": "POST"
            }
          }
        }
      }
    }
  }
}
